# Optional: use your own free key from data.gov.in to avoid the shared demo limit.
DATA_GOV_API_KEY=
# Generate a long random value before deploying beyond local use.
SECRET_KEY=

# --- Email delivery (OTP codes + price alerts) ---
# Leave SMTP_HOST empty to run in dev mode: messages are logged to the backend
# console and OTP codes are returned to the UI for local testing.
# Configure these in production and the dev fallback switches itself off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=

# --- SMS delivery (ready to plug in; uses only the Python stdlib) ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Price alert background worker ---
# How often every active alert is evaluated (seconds). Default 120.
ALERT_CHECK_INTERVAL_SECONDS=120
# Minimum minutes between two notifications for the same alert. Default 240.
ALERT_COOLDOWN_MINUTES=240
